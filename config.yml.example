files:
  _cleanup:
    path: "tasks/_cleanup.yml"
    headers:
      - default.yml
    vars:
      - _cleanup.yml
    tasks:
      - _cleanup.yml
  _time:
    path: "tasks/_time.yml"
    headers:
      - default.yml
    tasks:
      - _time.yml
  cleanup_example:
    path: "examples/cleanup.yml"
    headers:
      - default.yml
    includes:
      - _cleanup.yml
      - _time.yml
    tasks:
      - default.yml
      - cleanup_example.yml
  tasks_example:
    path: "Taskfile.yml"
    headers:
      - silent.yml
    includes:
      - _cleanup.yml
      - _time.yml
    vars:
      - dir.yml
    tasks:
      - default.yml
      - tasks_example.yml
