templates:
  - templates
ignore:
  - .DS_Store
  - .gitkeep
presets:
  default:
    version:
      - default.yml
    dotenv:
      - dotenv.yml
    silent:
      - silent.yml
    vars:
      - cleanup.yml
      - time.yml
    tasks:
      - default.yml
      - cleanup.yml
      - notify.yml
      - time.yml
  project:
    presets:
      - default
    dotenv:
      - project.yml
files:
  THIS_PROJECT:
    path: "Taskfile.yml"
    presets:
      - default
    vars:
      - THIS_PROJECT.yml
    tasks:
      - THIS_PROJECT.yml
  cleanup:
    path: "examples/cleanup/Taskfile.yml"
    presets:
      - default
  docker_buildx:
    path: "examples/docker_buildx/Taskfile.yml"
    presets:
      - project
    tasks:
      - docker_buildx.yml
      - skopeo.yml
  docker:
    path: "examples/docker/Taskfile.yml"
    presets:
      - default
    tasks:
      - docker.yml
  go:
    path: "examples/go/Taskfile.yml"
    presets:
      - project
    vars:
      - go.yml
    tasks:
      - go.yml
  os:
    path: "examples/os/Taskfile.yml"
    presets:
      - default
    vars:
      - os.yml
    tasks:
      - os.yml
  skopeo:
    path: "examples/skopeo/Taskfile.yml"
    presets:
      - default
    tasks:
      - skopeo.yml
  tf-cml:
    path: "examples/tf-cml/Taskfile.yml"
    presets:
      - default
    tasks:
      - tf-cml.yml
  uv:
    path: "examples/uv/Taskfile.yml"
    presets:
      - default
    tasks:
      - uv.yml
  zensical:
    path: "examples/zensical/Taskfile.yml"
    presets:
      - default
    tasks:
      - uv.yml
      - zensical.yml
